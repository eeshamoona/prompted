# Copy this file to .env.local and fill in each value. Never commit .env.local.

# Supabase — project's "Connect" dialog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase — Settings > API Keys (server only; used by the morning reminder job)
SUPABASE_SECRET_KEY=

# OpenAI — platform.openai.com, API keys page
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Resend — resend.com, API Keys (test mode only emails your own address)
RESEND_API_KEY=
# Dev safety: reminder emails go ONLY to these addresses (comma-separated)
EMAIL_ALLOWLIST=

# Any long random string; protects the reminder job from outside calls
CRON_SECRET=

# Optional: your deployed URL, used in reminder links (e.g. https://prompted.vercel.app)
NEXT_PUBLIC_APP_URL=
# Optional: sender once you verify a domain in Resend (defaults to onboarding@resend.dev)
EMAIL_FROM=

# Who can open /admin (comma-separated emails). Leave empty and nobody can.
ADMIN_EMAILS=
